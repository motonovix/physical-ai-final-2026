VLADROP_PRE  = /path/to/policy_lab/results/vladrop-drop9-rev8-pre
VLADROP_POST = /path/to/policy_lab/results/vladrop-drop9-ft-rev8-post
# SmolVLA の 1 試行のフォルダ（中に rollout.mp4 と result.json がある）
SMOLVLA_RUN  = /path/to/evaluations/t3_red_mug_18ep_v1/step001000_seed42_teleop_env
